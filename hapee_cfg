global
    # Lua configuration
    lua-load /path/to/rate_limiter.lua
    
    # Allow runtime API for map file reloading
    stats socket /var/run/haproxy.sock mode 666 level admin
    
frontend adscimapi
    bind *:80
    log global
    option httplog
    mode http
    monitor-uri /checkstatus

    # Define stick table for rate limiting
    stick-table type string len 64 size 1m expire 1m store http_req_rate(10s),http_req_rate(60s)

    # Call Lua script to setup rate limiting variables
    http-request lua.setup_rate_limiting
    
    # Track the request using the combined key from Lua
    http-request track-sc0 var(txn.tracking_key)
    
    # Create ACLs for rate limiting
    acl rate_limit_exceeded sc0_http_req_rate(60s) gt var(txn.rate_limit)
    
    # Deny requests that exceed their rate limit
    http-request deny if rate_limit_exceeded
    
    # Continue with normal processing
    default_backend api_backend

backend api_backend
    balance roundrobin
    # Your backend server definitions here
    server server1 127.0.0.1:8080 check
